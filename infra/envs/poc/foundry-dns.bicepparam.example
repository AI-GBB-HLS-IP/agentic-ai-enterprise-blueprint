using './foundry-dns.bicep'

// PLACEHOLDER VALUES ONLY. This tracked .example file must never contain real subscription-
// specific values (per repo confidentiality convention). Copy it to a local, untracked
// `foundry-dns.bicepparam` and replace every placeholder before deploying.
//
// Deploy this scoped to the SAME resource group as foundry.bicep, only after foundry.bicep's
// deployment has succeeded and its private endpoints exist. Replace each endpoint ID below with
// a full ARM resource ID when that endpoint exists, or set it to '' to skip its association.
//
// In vnet-link mode, dnsSubscriptionId must match the workload subscription and
// dnsResourceGroupName must match networkResourceGroupName. In zone-group mode, set both values
// to the explicit subscription and resource group that contain the existing private DNS zones.

param networkResourceGroupName = '<network-resource-group>'
param dnsIntegrationMode = 'vnet-link'
param dnsSubscriptionId = '<dns-zone-subscription-id>'
param dnsResourceGroupName = '<dns-zone-resource-group>'
param vnetName = '<existing-vnet-name>'
param foundryPrivateEndpointId = '/subscriptions/<workload-subscription-id>/resourceGroups/<foundry-resource-group>/providers/Microsoft.Network/privateEndpoints/<foundry-private-endpoint-name>'
param storagePrivateEndpointId = '/subscriptions/<workload-subscription-id>/resourceGroups/<foundry-resource-group>/providers/Microsoft.Network/privateEndpoints/<storage-private-endpoint-name>'
param keyVaultPrivateEndpointId = '/subscriptions/<workload-subscription-id>/resourceGroups/<foundry-resource-group>/providers/Microsoft.Network/privateEndpoints/<key-vault-private-endpoint-name>'
param cosmosDBPrivateEndpointId = '/subscriptions/<workload-subscription-id>/resourceGroups/<foundry-resource-group>/providers/Microsoft.Network/privateEndpoints/<cosmos-db-private-endpoint-name>'
param aiSearchPrivateEndpointId = '/subscriptions/<workload-subscription-id>/resourceGroups/<foundry-resource-group>/providers/Microsoft.Network/privateEndpoints/<ai-search-private-endpoint-name>'
