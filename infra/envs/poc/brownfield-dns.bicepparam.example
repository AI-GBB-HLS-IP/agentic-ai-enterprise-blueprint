using './brownfield-dns.bicep'

// PLACEHOLDER VALUES ONLY. This tracked .example file must never contain real subscription-
// specific values (per repo confidentiality convention). Copy it to a local, untracked
// `brownfield-dns.bicepparam` and replace every placeholder before deploying. See
// specs/00-network-foundation/quickstart.md.
//
// Deploy this template scoped to a single, explicit DNS zone resource group (one DNS-owner
// invocation per scope) — it must be run separately from brownfield-network.bicepparam.

param dnsIntegrationMode = 'vnet-link'
param dnsSubscriptionId = '<dns-zone-subscription-id>'
param dnsResourceGroupName = '<dns-zone-resource-group>'
param vnetId = '<full-arm-resource-id-of-existing-vnet>'
param vnetName = '<existing-vnet-name>'
